[Unit]
Description=Head unit screen dimmer (backlight / HDMI DDC / overlay)
After=graphical-session.target

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
# wait for the desktop (labwc) to be up before attaching the overlay
ExecStartPre=/bin/sh -c 'for i in $(seq 90); do [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /opt/headunit/bin/hu-dimmer.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
