[Unit]
Description=Head unit: read ahead from the SD card what the last start needed (bin/hu-preload.py)
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/opt/headunit/bin/hu-preload.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/headunit/bin/hu-preload.py

[Install]
WantedBy=sysinit.target
