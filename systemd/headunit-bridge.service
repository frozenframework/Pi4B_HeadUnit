[Unit]
Description=Head unit bridge (maps, routing, music, radio for the Hudiy apps)
After=pipewire.service wireplumber.service

[Service]
Environment=HU_CONF=/etc/headunit/headunit.conf
ExecStart=/opt/headunit-venv/bin/python /opt/headunit/bin/hu-bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
