# ---------------------------------------------------------------------------------------------
# Head unit first-boot settings. This file lives on the SD card's boot partition
# (the "bootfs" drive your Mac shows after flashing), in the folder "headunit".
# Edit it on your computer BEFORE the first boot. Flash with Raspberry Pi Imager and answer
# "No" to OS customisation: everything it would ask is set here, and there's no setup wizard.
# ---------------------------------------------------------------------------------------------

# Which vehicle this card is for: f250, miata or frontier
VEHICLE=f250

# Parts tier you built (1, 2 or 3). Tier 3 adds AM/FM radio and the CarPiHAT power board.
TIER=2

# Offline map region: texas-plus (TX, LA, OK, NM, AR), texas, or us
MAP_REGION=texas-plus

# Screen. Leave empty for the vehicle's own screen (Waveshare 7.9" in the F-250 and Miata).
# Bench testing on a normal HDMI monitor with a mouse + keyboard: DISPLAY_TYPE=monitor
# (later, switch to the car screen with: sudo /opt/headunit/setup.sh --set DISPLAY_TYPE=waveshare-7.9 --only 20-display)
DISPLAY_TYPE=""

# Download the map display data on first boot (needs Wi-Fi; texas-plus is a few GB)
MAPS_AUTO=1

# Login for the head unit (desktop logs in automatically; used for the terminal / SSH / sudo).
# Change the password after setup with: passwd   (it's erased from this card on first boot)
HU_USERNAME=headunit
HU_PASSWORD=headunit

# Country, language, time zone, keyboard. All can be changed later in
# Head Unit Settings > Region & language.
WIFI_COUNTRY=US
LOCALE=en_US.UTF-8
TIMEZONE=America/Chicago
KEYBOARD=us

# Network name of the head unit (blank = <vehicle>-headunit, e.g. miata-headunit.local)
HOSTNAME=""
# SSH login over Wi-Fi: 0 = off (safer with the default password), 1 = on.
# It can also be switched on later in Head Unit Settings > Developer.
ENABLE_SSH=0

# Wi-Fi for first-boot setup.
WIFI_SSID=""
WIFI_PSK=""

# Your phone's hotspot, used for software updates when you're away from home Wi-Fi (optional).
# Copy the name exactly as the phone shows it (iPhone: Settings > General > About > Name;
# iPhones use a curly apostrophe, so renaming the phone to plain letters avoids typos).
# Both passwords are erased from this card after first boot.
HOTSPOT_SSID=""
HOTSPOT_PSK=""

# Hudiy (CarPlay / Android Auto). Put hudiy_installer.tar.gz from your order email in the "hudiy"
# folder next to this file (don't unpack it), and your order number here, e.g. HUDIY_ORDER="#12345".
# Hudiy's installer checks the order number online: that is its license check. First boot installs
# Hudiy before anything else (it wants a clean OS), then removes the installer and the order number
# from this card. Without an order number, Hudiy is skipped and you can run its installer later.
HUDIY_ORDER=""
